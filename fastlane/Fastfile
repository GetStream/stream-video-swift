private_lane :build_example_app do |options|
  options[:project] ||= xcode_project
  app_sources =
    case options[:scheme]
    when 'DemoApp'
      :swiftui_sample_apps
    when 'DemoAppUIKit'
      :uikit_sample_apps
    when 'DocumentationTests'
